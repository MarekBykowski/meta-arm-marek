From ebcf47579b4cc3f1ad9a9bc864128d337ba01dd3 Mon Sep 17 00:00:00 2001
From: Marek Bykowski <marek.bykowski@gmail.com>
Date: Tue, 17 Jun 2025 09:44:30 +0000
Subject: [PATCH] comments, breakpoints

Upstream-Status: Denied

Signed-off-by: Marek Bykowski <marek.bykowski@gmail.com>
---
 arch/arm/cpu/armv8/cache_v8.c   |  1 +
 arch/arm/cpu/armv8/exceptions.S | 13 +++++++++++++
 arch/arm/cpu/armv8/start.S      | 17 +++++++++++++++++
 arch/arm/lib/crt0_64.S          |  9 +++++++++
 common/board_f.c                |  7 +++++++
 5 files changed, 47 insertions(+)

diff --git a/arch/arm/cpu/armv8/cache_v8.c b/arch/arm/cpu/armv8/cache_v8.c
index cb1131a0480..1b89a16142c 100644
--- a/arch/arm/cpu/armv8/cache_v8.c
+++ b/arch/arm/cpu/armv8/cache_v8.c
@@ -482,6 +482,7 @@ static void setup_all_pgtables(void)
 	gd->arch.tlb_addr = tlb_addr;
 	gd->arch.tlb_size = tlb_size;
 }
+void mbtrain_setup_all_pgtables_(void) __attribute__((weak, alias("setup_all_pgtables")));
 
 /* to activate the MMU we need to set up virtual memory */
 __weak void mmu_setup(void)
diff --git a/arch/arm/cpu/armv8/exceptions.S b/arch/arm/cpu/armv8/exceptions.S
index 504d566721c..740f68165c2 100644
--- a/arch/arm/cpu/armv8/exceptions.S
+++ b/arch/arm/cpu/armv8/exceptions.S
@@ -36,6 +36,19 @@
 	.globl	vectors
 vectors:
 	.align	7		/* Current EL Synchronous Thread */
+	/* mb: Typical stack ops. Push and pop.
+	 *
+	 * Push (grow down) on stack (change before store):
+	 *   stp x1, x2, [sp, #-16]!
+	 *   sp = sp - 16
+	 *   x1 -> sp, x2 -> sp + 8
+	 *
+	 * Pop (grow up) from stack (load before change):
+	 *   ldp x1, x2, [sp], #16
+	 *   x -> sp, x2 -> sp + 8
+	 *   sp = sp + 16
+	 *
+	 */
 	stp	x29, x30, [sp, #-16]!
 	bl	_exception_entry
 	bl	do_bad_sync
diff --git a/arch/arm/cpu/armv8/start.S b/arch/arm/cpu/armv8/start.S
index f3ea8585770..cf9eadc8d19 100644
--- a/arch/arm/cpu/armv8/start.S
+++ b/arch/arm/cpu/armv8/start.S
@@ -53,6 +53,10 @@ _bss_end_ofs:
 	.quad	__bss_end - _start
 
 reset:
+	/* mb: reset vector */
+	.globl mb_reset_vector
+mb_reset_vector:
+	0:	b 0b
 	/* Allow the board to save important registers */
 	b	save_boot_params
 .globl	save_boot_params_ret
@@ -108,6 +112,19 @@ pie_fixup_done:
 .macro	set_vbar, regname, reg
 	msr	\regname, \reg
 .endm
+
+
+/*
+ * mb: Get addr of vectors and set vbar upon it.
+ * Calculate an addr of label 'vectors' (PC-relative)
+ * PC-relative = addr of instruction + offset to label
+ * Then set vbar upon it  depending on the el.
+ * U-boot is at el2.
+ */
+	.globl  mb_vectors
+mb_vectors:
+	#0:	b 0b
+
 	adr	x0, vectors
 #else
 .macro	set_vbar, regname, reg
diff --git a/arch/arm/lib/crt0_64.S b/arch/arm/lib/crt0_64.S
index dcc924dd2f4..b405092c291 100644
--- a/arch/arm/lib/crt0_64.S
+++ b/arch/arm/lib/crt0_64.S
@@ -16,6 +16,7 @@
 #include <system-constants.h>
 
 /*
+ * mb: 'bl _main':start.S -> __main():arch/arm/lib/crt0_64.S
  * This file handles the target-independent stages of the U-Boot
  * start-up where a C runtime environment is needed. Its entry point
  * is _main and is branched into from the target's start.S file.
@@ -97,6 +98,9 @@ ENTRY(_main)
 #endif
 
 	mov	x0, #0
+	/* mb: calls board_init_f:common/board_f.c with array 'init_sequence_f'
+	 * of board init functions, among the others setup_reloc():common/board_f.c
+	 */
 	bl	board_init_f
 
 #if !defined(CONFIG_SPL_BUILD)
@@ -131,9 +135,14 @@ ENTRY(_main)
 	ldr	x9, [x18, #GD_RELOC_OFF]	/* x9 <- gd->reloc_off */
 	add	lr, lr, x9	/* new return address after relocation */
 	ldr	x0, [x18, #GD_RELOCADDR]	/* x0 <- gd->relocaddr */
+	/* mb: go for relocate_code():arch/arm/lib/relocate_64.S
+	 * Trick is we will return here but relocated.
+	 */
 	b	relocate_code
 
 relocation_return:
+	/* mb: post relocation*/
+	0: b 0b
 
 /*
  * Set up final (full) environment
diff --git a/common/board_f.c b/common/board_f.c
index 1688e27071f..c7d236cdbd1 100644
--- a/common/board_f.c
+++ b/common/board_f.c
@@ -9,6 +9,9 @@
  * Marius Groeger <mgroeger@sysgo.de>
  */
 
+/* mb: #define DEBUG has been replaced with #define LOG_DEBUG */
+#define LOG_DEBUG
+
 #include <common.h>
 #include <bloblist.h>
 #include <bootstage.h>
@@ -714,10 +717,14 @@ static int setup_reloc(void)
 	if (gd->flags & GD_FLG_SKIP_RELOC) {
 		debug("Skipping relocation due to flag\n");
 	} else {
+		/* mb: Print reloc offset */
+		/*__asm__ volatile("0: b 0b\n\t");*/
 		debug("Relocation Offset is: %08lx\n", gd->reloc_off);
 		debug("Relocating to %08lx, new gd at %08lx, sp at %08lx\n",
 		      gd->relocaddr, (ulong)map_to_sysmem(gd->new_gd),
 		      gd->start_addr_sp);
+		debug("Page table addr is: %08p\n",(u64) gd->arch.tlb_addr);
+		debug("Is page table filled in already? %d", gd->arch.tlb_fillptr);
 	}
 
 	return 0;
-- 
2.34.1

